# Applied on top of cu1000-neo_defconfig (the closest upstream board, X1000).
CONFIG_MACH_INGENIC_SOC=y
# CONFIG_X1000_CU1000_NEO is not set
CONFIG_X1600_HIBY_R1=y
CONFIG_HIBY_R1_BOOT_MARKS=y
# 64 MiB: no highmem.
# CONFIG_HIGHMEM is not set
# r1jump loads vmlinux.bin with the DTB appended.
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_INGENIC_SYSOST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/r1/initramfs/list"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Console on the framebuffer the stock kernel left running.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_PRINTK_TIME=y
# cu1000-neo's built-in command line adds earlycon, useless without a serial
# console. Keep clk_ignore_unused: a clock driver must not gate the clocks the
# stock kernel left running for the display.
CONFIG_CMDLINE="clk_ignore_unused"
# Stay on a panic message until the watchdog resets the R1.
CONFIG_PANIC_TIMEOUT=0
# Nothing to talk to yet.
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_SERIAL_8250 is not set
