# Applied on top of cu1000-neo_defconfig (the closest upstream board, X1000).
CONFIG_MACH_INGENIC_SOC=y
# CONFIG_X1000_CU1000_NEO is not set
CONFIG_X1600_HIBY_R1=y
CONFIG_HIBY_R1_BOOT_MARKS=y
# 64 MiB: no highmem.
# CONFIG_HIGHMEM is not set
# r1jump loads vmlinux.bin with the DTB appended.
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_INGENIC_SYSOST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/r1/initramfs/list"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Console on the framebuffer the stock kernel left running.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_PRINTK_TIME=y
# Take the command line from the device tree's bootargs only (cu1000-neo
# builds one in, which then replaces bootargs).
# CONFIG_CMDLINE_BOOL is not set
CONFIG_MIPS_CMDLINE_FROM_DTB=y
# Stay on a panic message until the watchdog resets the R1.
CONFIG_PANIC_TIMEOUT=0
# Nothing to talk to yet.
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_SERIAL_8250 is not set
# USB: peripheral only, a serial gadget for a shell from the Mac.
# CONFIG_USB is not set
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_G_SERIAL=y
# SD card (MSC1), PIO for now, and its exFAT filesystem.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_JZ4740=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
# X1600 clocks (CGU) and pins.
CONFIG_INGENIC_CGU_X1600=y
CONFIG_PINCTRL_INGENIC=y
# Audio: X1600 I2S over PDMA to the CS43131 DAC on a bit-banged I2C bus.
CONFIG_DMADEVICES=y
CONFIG_DMA_JZ4780=y
CONFIG_I2C=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_JZ4780=y
# /dev/i2c-N, for i2cdetect and i2cget.
CONFIG_I2C_CHARDEV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_JZ4740_SOC_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_CS43130=y
# Touch: CST816-compatible panel on I2C1.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CST816X=y
