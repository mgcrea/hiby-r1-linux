# Applied on top of cu1000-neo_defconfig (the closest upstream board, X1000).
CONFIG_MACH_INGENIC_SOC=y
# CONFIG_X1000_CU1000_NEO is not set
CONFIG_X1600_HIBY_R1=y
CONFIG_HIBY_R1_BOOT_MARKS=y
# 64 MiB: no highmem.
# CONFIG_HIGHMEM is not set
# r1jump loads vmlinux.bin with the DTB appended.
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_INGENIC_SYSOST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/r1/initramfs/list"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Console on the framebuffer the stock kernel left running, until the
# display driver takes over.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# Two pages, flipped with FBIOPAN_DISPLAY, as the stock jzfb gives r1player.
CONFIG_DRM_FBDEV_OVERALLOC=200
CONFIG_DRM_INGENIC_X1600=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_DRM_PANEL_HIBY_LG35583=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_PWM=y
CONFIG_PWM_INGENIC_X1600=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_PRINTK_TIME=y
# Take the command line from the device tree's bootargs only (cu1000-neo
# builds one in, which then replaces bootargs).
# CONFIG_CMDLINE_BOOL is not set
CONFIG_MIPS_CMDLINE_FROM_DTB=y
# Stay on a panic message until the watchdog resets the R1.
CONFIG_PANIC_TIMEOUT=0
# Modules only for Wi-Fi, which won't fit the flash kernel slot built in:
# loaded from the system image (tools/mksystem.py) when Wi-Fi is turned on.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Keeps only the exported symbols these modules use: the whole table is
# 133 KB of the compressed image (2026-10-25).
CONFIG_TRIM_UNUSED_KSYMS=y
# Bluetooth: the BCM43430A1 on UART0 (hci_uart's Broadcom protocol on
# serdev), and Unix sockets for dbus, which bluetoothd and bluealsa use.
CONFIG_NET=y
CONFIG_UNIX=y
# IPv4 only for adbd, which listens on tcp:5037 and exits when it can't.
CONFIG_INET=y
# CONFIG_IPV6 is not set
# CONFIG_INET_DIAG is not set
# CONFIG_NETFILTER is not set
# udhcpc's raw sockets.
CONFIG_PACKET=y
# CONFIG_NET_NS is not set
# CONFIG_NET_HANDSHAKE is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_BQL is not set
# defconfig's NFS, which comes back with CONFIG_INET.
# CONFIG_NETWORK_FILESYSTEMS is not set
# Wi-Fi: the AP6212's BCM43430A1 on MSC0 (SDIO), through brcmfmac, and
# wpa_supplicant over nl80211. No Ethernet (cu1000-neo_defconfig's).
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
# CONFIG_CFG80211_WEXT is not set
# CONFIG_MAC80211 is not set
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_BRCMFMAC_PCIE is not set
# CONFIG_ETHERNET is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_PHYLIB is not set
# cu1000-neo_defconfig modules nothing here uses.
# CONFIG_HW_RANDOM is not set
# CONFIG_SENSORS_ADS7828 is not set
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_INGENIC=y
# AVRCP keys of a headset come through uinput.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# USB: peripheral only, a gadget built through configfs (initramfs/r1-usb):
# a serial port for a shell from the Mac, and ADB through FunctionFS.
# CONFIG_USB is not set
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
# The USB PHY: after a reset it's gated and suspended (started from flash,
# nothing before the kernel turns it on).
CONFIG_GENERIC_PHY=y
CONFIG_PHY_INGENIC_USB=y
# CONFIG_USB_G_SERIAL is not set
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
# The SD card as a USB disk while the computer has it (initramfs/r1-share).
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# SD card (MSC1) and its exFAT filesystem.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_JZ4740=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
# X1600 clocks (CGU) and pins.
CONFIG_INGENIC_CGU_X1600=y
CONFIG_PINCTRL_INGENIC=y
# Audio: X1600 I2S over PDMA to the CS43131 DAC on a bit-banged I2C bus.
CONFIG_DMADEVICES=y
CONFIG_DMA_JZ4780=y
CONFIG_I2C=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_JZ4780=y
# /dev/i2c-N, for i2cdetect and i2cget.
CONFIG_I2C_CHARDEV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_JZ4740_SOC_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_CS43130=y
# Touch: CST816-compatible panel on I2C1.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CST816X=y
# Keys: three on the X1600's ADC, power and next on GPIOs.
CONFIG_IIO=y
CONFIG_INGENIC_X1600_ADC=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
# PMIC (AXP2101): regulators, power-off, USB power and the charger; the CW2015 battery gauge.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y
# Required by BATTERY_AXP20X; nothing binds to it on the AXP2101.
CONFIG_AXP20X_ADC=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_CW2015=y
# The flash image (out/r1-linux.uimage) must fit the 5 MiB kernel slot.
CONFIG_KERNEL_XZ=y
# The flash kernel starts the card's with kexec (initramfs/r1-loader).
CONFIG_KEXEC=y
# No crash kernel: with it the kernel links at 0x84000000.
# CONFIG_CRASH_DUMP is not set
# Its decompressor runs from here, clear of the kernel it unpacks at
# 0x80100000 and of the DTB it copies behind it (the default, the kernel's
# end rounded up to 64K, left 2.5 KB for that copy).
CONFIG_ZBOOT_LOAD_ADDRESS=0x81000000
# The internal SPI-NAND through the SFC (all partitions read-only in the
# device tree for now), and no UBI, so nothing attaches to userdata.
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NAND=y
CONFIG_SPI_MEM=y
CONFIG_SPI_INGENIC_SFC=y
# CONFIG_MTD_UBI is not set
# CONFIG_MTD_BLOCK is not set
# The stock root filesystem in `rootfs` (an LZO squashfs), read-only: the
# libraries, adbd and BlueZ run from it, so the card can go to a computer.
CONFIG_MTD_BLOCK_RO=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZO=y
# CONFIG_SQUASHFS_ZLIB is not set
# The last boot's kernel log and oopses, in RAM the device tree reserves
# (ramoops), read after a reset from /sys/fs/pstore.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
