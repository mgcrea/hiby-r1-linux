# The card kernel's additions to r1.config (build.sh merges both): Wi-Fi,
# built in, which the 5 MiB flash kernel has no room for and doesn't need
# (it only hands over to this one, or stands in for it).
# The AP6212's BCM43430A1 on MSC0 (SDIO) through brcmfmac, wpa_supplicant
# over nl80211, and udhcpc's raw sockets. No Ethernet (cu1000-neo_defconfig's).
CONFIG_PACKET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
# CONFIG_MAC80211 is not set
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_BRCMFMAC_PCIE is not set
# CONFIG_ETHERNET is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_PHYLIB is not set
CONFIG_PWRSEQ_SIMPLE=y
