From f341385c6fdae75d80d7d956e6e5e5e3070ce67d Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Sun, 25 Oct 2026 10:21:25 +0000
Subject: [PATCH 59/60] mmc: jz4740: keep the clock running on a host with SDIO
 interrupts

Above 25 MHz the driver turns on the controller's low-power mode, which
stops the bus clock while the bus is idle. An SDIO card signals its
interrupt on DAT1 and needs the clock for it, so interrupts that come
while the bus is idle are lost.

With a BCM43430A1 on in-band interrupts (HiBy R1, X1600), brcmfmac puts
the chip to sleep when the bus has been idle and wakes it with a clock
request whose completion it learns of by interrupt: most attaches then
timed out in their first control frame ("dongle is not responding",
-145). With low-power mode off, 8 of 8 attaches worked, against 1 to 5
of 6 with it on.

Leave low-power mode off on hosts that take SDIO interrupts.
---
 drivers/mmc/host/jz4740_mmc.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/drivers/mmc/host/jz4740_mmc.c b/drivers/mmc/host/jz4740_mmc.c
index 9645337..79d852b 100644
--- a/drivers/mmc/host/jz4740_mmc.c
+++ b/drivers/mmc/host/jz4740_mmc.c
@@ -1036,6 +1036,13 @@ static int jz4740_mmc_set_clock_rate(struct jz4740_mmc_host *host, int rate)
 {
 	int div = 0;
 	int real_rate;
+	/*
+	 * Low-power mode stops the clock while the bus is idle, and an SDIO
+	 * card can only signal an interrupt with the clock running: brcmfmac
+	 * then waits forever for the one saying the chip is awake again.
+	 */
+	u32 lpm = host->mmc->caps & MMC_CAP_SDIO_IRQ ? 0 :
+		  JZ_MMC_LPM_LOW_POWER_MODE_EN;
 
 	jz4740_mmc_clock_disable(host);
 	clk_set_rate(host->clk, host->mmc->f_max);
@@ -1052,16 +1059,13 @@ static int jz4740_mmc_set_clock_rate(struct jz4740_mmc_host *host, int rate)
 	if (real_rate > 25000000) {
 		if (host->version >= JZ_MMC_JZ4780) {
 			writel(JZ_MMC_LPM_DRV_RISING_QTR_PHASE_DLY |
-				   JZ_MMC_LPM_SMP_RISING_QTR_OR_HALF_PHASE_DLY |
-				   JZ_MMC_LPM_LOW_POWER_MODE_EN,
+				   JZ_MMC_LPM_SMP_RISING_QTR_OR_HALF_PHASE_DLY | lpm,
 				   host->base + JZ_REG_MMC_LPM);
 		} else if (host->version >= JZ_MMC_JZ4760) {
-			writel(JZ_MMC_LPM_DRV_RISING |
-				   JZ_MMC_LPM_LOW_POWER_MODE_EN,
+			writel(JZ_MMC_LPM_DRV_RISING | lpm,
 				   host->base + JZ_REG_MMC_LPM);
 		} else if (host->version >= JZ_MMC_JZ4725B)
-			writel(JZ_MMC_LPM_LOW_POWER_MODE_EN,
-				   host->base + JZ_REG_MMC_LPM);
+			writel(lpm, host->base + JZ_REG_MMC_LPM);
 	}
 
 	return real_rate;
-- 
