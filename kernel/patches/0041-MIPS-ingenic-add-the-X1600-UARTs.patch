From 9c6b7f4775ddca9c786ab1b10a81eed440cfe1b1 Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Fri, 23 Oct 2026 20:33:27 +0000
Subject: [PATCH 41/55] MIPS: ingenic: add the X1600 UARTs

Four UARTs at 0x10030000-0x10033000, interrupts 47 to 44, as in the HiBy R1's
stock device tree, each with its CGU gate and the 24 MHz crystal as the baud
clock.
---
 arch/mips/boot/dts/ingenic/x1600.dtsi | 52 +++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/x1600.dtsi b/arch/mips/boot/dts/ingenic/x1600.dtsi
index 74c163c..a0ccc45 100644
--- a/arch/mips/boot/dts/ingenic/x1600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x1600.dtsi
@@ -132,6 +132,58 @@ gpd: gpio@3 {
 		};
 	};
 
+	uart0: serial@10030000 {
+		compatible = "ingenic,x1600-uart", "ingenic,x1000-uart";
+		reg = <0x10030000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <47>;
+
+		clocks = <&exclk>, <&cgu X1600_CLK_UART0>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,x1600-uart", "ingenic,x1000-uart";
+		reg = <0x10031000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <46>;
+
+		clocks = <&exclk>, <&cgu X1600_CLK_UART1>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart2: serial@10032000 {
+		compatible = "ingenic,x1600-uart", "ingenic,x1000-uart";
+		reg = <0x10032000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <45>;
+
+		clocks = <&exclk>, <&cgu X1600_CLK_UART2>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	uart3: serial@10033000 {
+		compatible = "ingenic,x1600-uart", "ingenic,x1000-uart";
+		reg = <0x10033000 0x100>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <44>;
+
+		clocks = <&exclk>, <&cgu X1600_CLK_UART3>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
 	i2c0: i2c@10050000 {
 		compatible = "ingenic,x1600-i2c";
 		reg = <0x10050000 0x1000>;
-- 
