From 602da5c0a6a0b6726a0fe9eddf08f1981d300958 Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Fri, 23 Oct 2026 09:00:55 +0000
Subject: [PATCH 32/54] MIPS: ingenic: add the X1600 LCD and PWM controllers
 and the HiBy R1's display

Describe the X1600's LCD and PWM controllers, and drive the HiBy R1's screen
with them: the LG35583 panel on the LCD controller, set up over a bit-banged
SPI bus, and its backlight on PWM channel 0 at the stock 30 kHz. The panel
now switches its supplies, BLDO1 and BLDO2, so they are no longer always on.

The simple framebuffer stays, for the console until the display driver takes
the screen over.
---
 arch/mips/boot/dts/ingenic/hiby-r1.dts | 90 ++++++++++++++++++++++----
 arch/mips/boot/dts/ingenic/x1600.dtsi  | 24 +++++++
 2 files changed, 102 insertions(+), 12 deletions(-)

diff --git a/arch/mips/boot/dts/ingenic/hiby-r1.dts b/arch/mips/boot/dts/ingenic/hiby-r1.dts
index 765007d..c63101c 100644
--- a/arch/mips/boot/dts/ingenic/hiby-r1.dts
+++ b/arch/mips/boot/dts/ingenic/hiby-r1.dts
@@ -27,13 +27,14 @@ reserved-memory {
 		ranges;
 
 		/*
-		 * The display controller keeps scanning out what the stock
-		 * kernel set up: two 480x800 RGB565 pages, through a frame
-		 * descriptor the controller rereads every frame. The stock
-		 * kernel allocates that descriptor anywhere, so before the
-		 * jump the loader chains it to a self-linked copy at
-		 * 0x02776f00, in the last row of page 1: memory the stock
-		 * kernel won't hand out, and which nothing shows here.
+		 * Until its driver takes over, the display controller keeps
+		 * scanning out what the stock kernel set up: two 480x800
+		 * RGB565 pages, through a frame descriptor the controller
+		 * rereads every frame. The stock kernel allocates that
+		 * descriptor anywhere, so before the jump the loader chains
+		 * it to a self-linked copy at 0x02776f00, in the last row of
+		 * page 1: memory the stock kernel won't hand out, and which
+		 * nothing shows here.
 		 */
 		lcd_pages: framebuffer@2600000 {
 			reg = <0x02600000 0x177000>;
@@ -53,6 +54,44 @@ framebuffer@2600000 {
 		clocks = <&cgu X1600_CLK_LCD>;
 	};
 
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm 0 33333 0>;
+
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <60>;
+	};
+
+	/* The panel's set-up bus: bit-banged, write only. */
+	spi-lcd {
+		compatible = "spi-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		sck-gpios = <&gpa 0 GPIO_ACTIVE_HIGH>;
+		mosi-gpios = <&gpa 1 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&gpa 30 GPIO_ACTIVE_LOW>;
+		num-chipselects = <1>;
+
+		panel@0 {
+			compatible = "hiby,lg35583";
+			reg = <0>;
+			spi-max-frequency = <1000000>;
+
+			vcc-supply = <&vcc_lcd>;
+			vccio-supply = <&vccio_lcd>;
+			reset-gpios = <&gpa 31 GPIO_ACTIVE_LOW>;
+			backlight = <&backlight>;
+
+			port {
+				panel_in: endpoint {
+					remote-endpoint = <&lcd_out>;
+				};
+			};
+		};
+	};
+
 	/* Three buttons share ADC channel 0, each pulling it to its own level. */
 	keys-adc {
 		compatible = "adc-keys";
@@ -281,19 +320,16 @@ aldo4 {
 				regulator-always-on;
 			};
 
-			/* The panel, still as the stock kernel set it up. */
-			bldo1 {
+			vcc_lcd: bldo1 {
 				regulator-name = "vcc-lcd";
 				regulator-min-microvolt = <2800000>;
 				regulator-max-microvolt = <2800000>;
-				regulator-always-on;
 			};
 
-			bldo2 {
+			vccio_lcd: bldo2 {
 				regulator-name = "vccio-lcd";
 				regulator-min-microvolt = <2800000>;
 				regulator-max-microvolt = <2800000>;
-				regulator-always-on;
 			};
 		};
 	};
@@ -367,6 +403,26 @@ &otg {
 	dr_mode = "peripheral";
 };
 
+&lcd {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_lcd>;
+
+	status = "okay";
+
+	port {
+		lcd_out: endpoint {
+			remote-endpoint = <&panel_in>;
+		};
+	};
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_pwm0>;
+
+	status = "okay";
+};
+
 &pinctrl {
 	pins_i2c0: i2c0 {
 		function = "i2c0";
@@ -396,6 +452,16 @@ pins_pmic_irq: pmic-irq {
 		bias-pull-up;
 	};
 
+	pins_lcd: lcd {
+		function = "lcd";
+		groups = "lcd-18bit-msb";
+	};
+
+	pins_pwm0: pwm0 {
+		function = "pwm0";
+		groups = "pwm0";
+	};
+
 	pins_msc1: msc1 {
 		function = "mmc1";
 		groups = "mmc1-1bit", "mmc1-4bit";
diff --git a/arch/mips/boot/dts/ingenic/x1600.dtsi b/arch/mips/boot/dts/ingenic/x1600.dtsi
index a7cf29d..712cc23 100644
--- a/arch/mips/boot/dts/ingenic/x1600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x1600.dtsi
@@ -208,6 +208,19 @@ ost: timer@12000000 {
 		interrupts = <4>;
 	};
 
+	lcd: lcd-controller@13050000 {
+		compatible = "ingenic,x1600-lcd";
+		reg = <0x13050000 0x10000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <31>;
+
+		clocks = <&cgu X1600_CLK_LCD>;
+		clock-names = "lcd";
+
+		status = "disabled";
+	};
+
 	pdma: dma-controller@13420000 {
 		compatible = "ingenic,x1600-dma", "ingenic,x1830-dma";
 		reg = <0x13420000 0x400>, <0x13421000 0x40>;
@@ -246,6 +259,17 @@ mmc1: mmc@13460000 {
 		status = "disabled";
 	};
 
+	pwm: pwm@134c0000 {
+		compatible = "ingenic,x1600-pwm";
+		reg = <0x134c0000 0x200>;
+
+		#pwm-cells = <3>;
+
+		clocks = <&cgu X1600_CLK_PWM>;
+
+		status = "disabled";
+	};
+
 	otg: usb@13500000 {
 		compatible = "ingenic,x1600-otg", "snps,dwc2";
 		reg = <0x13500000 0x40000>;
-- 
2.39.5

