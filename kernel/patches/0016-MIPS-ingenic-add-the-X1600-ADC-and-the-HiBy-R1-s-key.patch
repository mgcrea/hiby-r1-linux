From d5b8182443ddf677e937c8419d310c344caa4003 Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Fri, 23 Oct 2026 07:39:55 +0000
Subject: [PATCH 16/40] MIPS: ingenic: add the X1600 ADC and the HiBy R1's keys

X1600: the SAR ADC at 0x10070000, interrupt 11.

HiBy R1: play/pause, volume down and volume up on ADC channel 0 (0, 1.0
and 1.65 V, 3.3 V released, as the stock firmware reads them) through
adc-keys; power on PC31 (active low) and next on PC28 (active high)
through gpio-keys.
---
 arch/mips/boot/dts/ingenic/hiby-r1.dts | 45 ++++++++++++++++++++++++++
 arch/mips/boot/dts/ingenic/x1600.dtsi  | 13 ++++++++
 2 files changed, 58 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/hiby-r1.dts b/arch/mips/boot/dts/ingenic/hiby-r1.dts
index bcdf364..69b6699 100644
--- a/arch/mips/boot/dts/ingenic/hiby-r1.dts
+++ b/arch/mips/boot/dts/ingenic/hiby-r1.dts
@@ -4,6 +4,7 @@
 #include "x1600.dtsi"
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
 / {
@@ -52,6 +53,50 @@ framebuffer@2600000 {
 		clocks = <&cgu X1600_CLK_LCD>;
 	};
 
+	/* Three buttons share ADC channel 0, each pulling it to its own level. */
+	keys-adc {
+		compatible = "adc-keys";
+		io-channels = <&adc 0>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <3300000>;
+		poll-interval = <50>;
+
+		button-play-pause {
+			label = "Play/Pause";
+			linux,code = <KEY_PLAYPAUSE>;
+			press-threshold-microvolt = <0>;
+		};
+
+		button-volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			press-threshold-microvolt = <1000000>;
+		};
+
+		button-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			press-threshold-microvolt = <1650000>;
+		};
+	};
+
+	keys-gpio {
+		compatible = "gpio-keys";
+
+		key-power {
+			label = "Power";
+			gpios = <&gpc 31 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			wakeup-source;
+		};
+
+		key-next {
+			label = "Next";
+			gpios = <&gpc 28 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_NEXTSONG>;
+		};
+	};
+
 	/* PB2 powers the DAC; which of its rails it switches isn't known. */
 	vdac: regulator-dac {
 		compatible = "regulator-fixed";
diff --git a/arch/mips/boot/dts/ingenic/x1600.dtsi b/arch/mips/boot/dts/ingenic/x1600.dtsi
index 45c78bc..a7cf29d 100644
--- a/arch/mips/boot/dts/ingenic/x1600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x1600.dtsi
@@ -181,6 +181,19 @@ i2s: i2s@10079000 {
 		status = "disabled";
 	};
 
+	adc: adc@10070000 {
+		compatible = "ingenic,x1600-adc";
+		reg = <0x10070000 0x30>;
+
+		clocks = <&cgu X1600_CLK_SADC>;
+		clock-names = "adc";
+
+		interrupt-parent = <&intc>;
+		interrupts = <11>;
+
+		#io-channel-cells = <1>;
+	};
+
 	ost: timer@12000000 {
 		compatible = "ingenic,x1600-ost", "ingenic,x1000-ost";
 		reg = <0x12000000 0x3c>;
-- 
2.39.5

