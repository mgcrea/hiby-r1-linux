--- /dev/null
+++ b/drivers/clk/ingenic/x1600-cgu.c
@@ -0,0 +1,486 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * X1600 SoC CGU driver
+ *
+ * The register layout was read from the clock tables of the vendor kernel
+ * running on a HiBy R1, and every rate checked against its clk_summary.
+ * The PLLs and the CPU, L2, AHB, APB and DDR clocks are read-only: the
+ * bootloader sets them up and nothing here may change them.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/rational.h>
+
+#include <dt-bindings/clock/ingenic,x1600-cgu.h>
+
+#include "cgu.h"
+
+/* CGU register offsets */
+#define CGU_REG_CPCCR		0x00
+#define CGU_REG_APLL		0x10
+#define CGU_REG_MPLL		0x14
+#define CGU_REG_EPLL		0x18
+#define CGU_REG_CLKGR0		0x20
+#define CGU_REG_OPCR		0x24
+#define CGU_REG_CLKGR1		0x28
+#define CGU_REG_DDRCDR		0x2c
+#define CGU_REG_MACCDR		0x54
+#define CGU_REG_SSICDR		0x5c
+#define CGU_REG_I2SRCDR		0x60
+#define CGU_REG_LPCDR		0x64
+#define CGU_REG_MSC0CDR		0x68
+#define CGU_REG_PWMCDR		0x6c
+#define CGU_REG_SFCCDR		0x74
+#define CGU_REG_CIMCDR		0x78
+#define CGU_REG_I2STCDR		0x7c
+#define CGU_REG_MSC1CDR		0xa4
+
+/*
+ * PLL: rate = ext * M / (N * OD1 * OD0), with M in bits 31:20, N in 19:14,
+ * OD1 in 13:11 and OD0 in 10:8, none of them offset or encoded.
+ */
+static const unsigned int x1600_pll_regs[] = {
+	[X1600_CLK_APLL] = CGU_REG_APLL,
+	[X1600_CLK_MPLL] = CGU_REG_MPLL,
+	[X1600_CLK_EPLL] = CGU_REG_EPLL,
+};
+
+static unsigned long x1600_pll_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
+{
+	struct ingenic_clk *ingenic_clk = to_ingenic_clk(hw);
+	u32 ctl = readl(ingenic_clk->cgu->base + x1600_pll_regs[ingenic_clk->idx]);
+	unsigned int m = (ctl >> 20) & 0xfff;
+	unsigned int n = (ctl >> 14) & 0x3f;
+	unsigned int od1 = (ctl >> 11) & 0x7;
+	unsigned int od0 = (ctl >> 8) & 0x7;
+
+	if (!n || !od1 || !od0)
+		return 0;
+	return div_u64((u64)parent_rate * m, n * od1 * od0);
+}
+
+static const struct clk_ops x1600_pll_ops = {
+	.recalc_rate = x1600_pll_recalc_rate,
+};
+
+/*
+ * I2S: rate = parent * M / N, with M in bits 28:20 and N in 19:0 of
+ * I2STCDR (transmit) and I2SRCDR (receive). Bit 29 enables the output.
+ */
+#define I2SCDR_EN		BIT(29)
+#define I2SCDR_M		GENMASK(28, 20)
+#define I2SCDR_N		GENMASK(19, 0)
+
+static const unsigned int x1600_i2s_regs[] = {
+	[X1600_CLK_I2S0_TX_DIV] = CGU_REG_I2STCDR,
+	[X1600_CLK_I2S0_RX_DIV] = CGU_REG_I2SRCDR,
+};
+
+static void __iomem *x1600_i2s_reg(struct clk_hw *hw)
+{
+	struct ingenic_clk *ingenic_clk = to_ingenic_clk(hw);
+
+	return ingenic_clk->cgu->base + x1600_i2s_regs[ingenic_clk->idx];
+}
+
+static void x1600_i2s_update(struct clk_hw *hw, u32 mask, u32 val)
+{
+	struct ingenic_cgu *cgu = to_ingenic_clk(hw)->cgu;
+	void __iomem *reg = x1600_i2s_reg(hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&cgu->lock, flags);
+	writel((readl(reg) & ~mask) | val, reg);
+	spin_unlock_irqrestore(&cgu->lock, flags);
+}
+
+static unsigned long x1600_i2s_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
+{
+	u32 cdr = readl(x1600_i2s_reg(hw));
+	unsigned int m = FIELD_GET(I2SCDR_M, cdr);
+	unsigned int n = FIELD_GET(I2SCDR_N, cdr);
+
+	if (!n)
+		return 0;
+	return div_u64((u64)parent_rate * m, n);
+}
+
+static void x1600_i2s_calc_m_n(unsigned long rate, unsigned long parent_rate,
+			       unsigned long *m, unsigned long *n)
+{
+	rational_best_approximation(rate, parent_rate,
+				    FIELD_MAX(I2SCDR_M), FIELD_MAX(I2SCDR_N), m, n);
+}
+
+static int x1600_i2s_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	unsigned long m, n;
+
+	if (!req->best_parent_rate)
+		return -EINVAL;
+	req->rate = min(req->rate, req->best_parent_rate);
+	x1600_i2s_calc_m_n(req->rate, req->best_parent_rate, &m, &n);
+	if (!m)
+		return -EINVAL;
+	req->rate = div_u64((u64)req->best_parent_rate * m, n);
+	return 0;
+}
+
+static int x1600_i2s_set_rate(struct clk_hw *hw, unsigned long rate,
+			      unsigned long parent_rate)
+{
+	unsigned long m, n;
+
+	x1600_i2s_calc_m_n(rate, parent_rate, &m, &n);
+	if (!m)
+		return -EINVAL;
+	x1600_i2s_update(hw, I2SCDR_M | I2SCDR_N,
+			 FIELD_PREP(I2SCDR_M, m) | FIELD_PREP(I2SCDR_N, n));
+	return 0;
+}
+
+static int x1600_i2s_enable(struct clk_hw *hw)
+{
+	x1600_i2s_update(hw, I2SCDR_EN, I2SCDR_EN);
+	return 0;
+}
+
+static void x1600_i2s_disable(struct clk_hw *hw)
+{
+	x1600_i2s_update(hw, I2SCDR_EN, 0);
+}
+
+static int x1600_i2s_is_enabled(struct clk_hw *hw)
+{
+	return !!(readl(x1600_i2s_reg(hw)) & I2SCDR_EN);
+}
+
+static const struct clk_ops x1600_i2s_ops = {
+	.recalc_rate = x1600_i2s_recalc_rate,
+	.determine_rate = x1600_i2s_determine_rate,
+	.set_rate = x1600_i2s_set_rate,
+	.enable = x1600_i2s_enable,
+	.disable = x1600_i2s_disable,
+	.is_enabled = x1600_i2s_is_enabled,
+};
+
+/* Dividers in the CDR registers: change enable 29, busy 28, stop 27. */
+#define X1600_CDR(_reg, _div, _bits) { _reg, 0, _div, _bits, 29, 28, 27 }
+
+static const struct ingenic_cgu_clk_info x1600_cgu_clocks[] = {
+
+	/* External clocks */
+
+	[X1600_CLK_EXCLK] = { "ext", CGU_CLK_EXT },
+	[X1600_CLK_OSC32K] = { "osc32k", CGU_CLK_EXT },
+
+	[X1600_CLK_EXT512] = {
+		"ext/512", CGU_CLK_FIXDIV,
+		.parents = { X1600_CLK_EXCLK, -1, -1, -1 },
+		.fixdiv = { 512 },
+	},
+
+	/*
+	 * The RTC clock of the TCU and its watchdog: EXCLK / 512 unless OPCR bit
+	 * 2 is set (the vendor kernel's mux_wdt, left at 0).
+	 *
+	 * The CGU registers clocks in ID order and finds a clock's parents among
+	 * those already registered, so both parents have lower IDs.
+	 */
+	[X1600_CLK_RTCLK] = {
+		"rtc", CGU_CLK_MUX,
+		.parents = { X1600_CLK_EXT512, X1600_CLK_OSC32K, -1, -1 },
+		.mux = { CGU_REG_OPCR, 2, 1 },
+	},
+
+	/* PLLs */
+
+	[X1600_CLK_APLL] = {
+		"apll", CGU_CLK_CUSTOM,
+		.parents = { X1600_CLK_EXCLK, -1, -1, -1 },
+		.custom = { &x1600_pll_ops },
+	},
+	[X1600_CLK_MPLL] = {
+		"mpll", CGU_CLK_CUSTOM,
+		.parents = { X1600_CLK_EXCLK, -1, -1, -1 },
+		.custom = { &x1600_pll_ops },
+	},
+	[X1600_CLK_EPLL] = {
+		"epll", CGU_CLK_CUSTOM,
+		.parents = { X1600_CLK_EXCLK, -1, -1, -1 },
+		.custom = { &x1600_pll_ops },
+	},
+
+	/* Muxes and dividers of the CPU and buses (CPCCR), read-only */
+
+	[X1600_CLK_SCLKA] = {
+		"sclk_a", CGU_CLK_MUX,
+		.parents = { -1, X1600_CLK_EXCLK, X1600_CLK_APLL, -1 },
+		.mux = { CGU_REG_CPCCR, 30, 2 },
+	},
+	[X1600_CLK_CPUMUX] = {
+		"cpu_mux", CGU_CLK_MUX,
+		.parents = { -1, X1600_CLK_SCLKA, X1600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 28, 2 },
+	},
+	[X1600_CLK_CPU] = {
+		"cpu", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X1600_CLK_CPUMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 0, 1, 4, 22, -1, -1 },
+	},
+	[X1600_CLK_L2CACHE] = {
+		"l2cache", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X1600_CLK_CPUMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 4, 1, 4, 22, -1, -1 },
+	},
+	[X1600_CLK_AHB0] = {
+		"ahb0", CGU_CLK_MUX | CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, X1600_CLK_SCLKA, X1600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 26, 2 },
+		.div = { CGU_REG_CPCCR, 8, 1, 4, 21, -1, -1 },
+	},
+	[X1600_CLK_AHB2PMUX] = {
+		"ahb2_apb_mux", CGU_CLK_MUX,
+		.parents = { -1, X1600_CLK_SCLKA, X1600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_CPCCR, 24, 2 },
+	},
+	[X1600_CLK_AHB2] = {
+		"ahb2", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X1600_CLK_AHB2PMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 12, 1, 4, 20, -1, -1 },
+	},
+	[X1600_CLK_PCLK] = {
+		"pclk", CGU_CLK_DIV,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { X1600_CLK_AHB2PMUX, -1, -1, -1 },
+		.div = { CGU_REG_CPCCR, 16, 1, 4, 20, -1, -1 },
+	},
+	[X1600_CLK_DDR] = {
+		"ddr", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.flags = CLK_IS_CRITICAL,
+		.parents = { -1, X1600_CLK_SCLKA, X1600_CLK_MPLL, -1 },
+		.mux = { CGU_REG_DDRCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_DDRCDR, 1, 4),
+		.gate = { CGU_REG_CLKGR0, 31 },
+	},
+
+	/* Peripheral clocks with their own mux, divider and gate */
+
+	[X1600_CLK_MSC0] = {
+		"msc0", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_MSC0CDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_MSC0CDR, 2, 8),
+		.gate = { CGU_REG_CLKGR0, 4 },
+	},
+	[X1600_CLK_MSC1] = {
+		"msc1", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_MSC1CDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_MSC1CDR, 2, 8),
+		.gate = { CGU_REG_CLKGR0, 5 },
+	},
+	[X1600_CLK_LCD] = {
+		"lcd", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_LPCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_LPCDR, 1, 8),
+		.gate = { CGU_REG_CLKGR0, 23 },
+	},
+	[X1600_CLK_SFC] = {
+		"sfc", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_SFCCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_SFCCDR, 1, 8),
+		.gate = { CGU_REG_CLKGR0, 2 },
+	},
+	[X1600_CLK_SSI] = {
+		"ssi", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_SSICDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_SSICDR, 1, 8),
+		.gate = { CGU_REG_CLKGR0, 19 },
+	},
+	[X1600_CLK_CIM] = {
+		"cim", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_CIMCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_CIMCDR, 1, 8),
+		.gate = { CGU_REG_CLKGR0, 22 },
+	},
+	[X1600_CLK_MACPHY] = {
+		"mac_phy", CGU_CLK_MUX | CGU_CLK_DIV,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_MACCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_MACCDR, 1, 8),
+	},
+	[X1600_CLK_PWM] = {
+		"pwm", CGU_CLK_MUX | CGU_CLK_DIV | CGU_CLK_GATE,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_MPLL, X1600_CLK_EPLL, -1 },
+		.mux = { CGU_REG_PWMCDR, 30, 2 },
+		.div = X1600_CDR(CGU_REG_PWMCDR, 1, 4),
+		.gate = { CGU_REG_CLKGR1, 5 },
+	},
+
+	/* I2S transmit and receive clocks: mux, M/N divider, gate */
+
+	[X1600_CLK_I2S0_TX_MUX] = {
+		"i2s0_tx_mux", CGU_CLK_MUX,
+		.parents = { X1600_CLK_SCLKA, X1600_CLK_EPLL, -1, -1 },
+		.mux = { CGU_REG_I2STCDR, 30, 1 },
+	},
+	[X1600_CLK_I2S0_TX_DIV] = {
+		"i2s0_tx_div", CGU_CLK_CUSTOM,
+		.parents = { X1600_CLK_I2S0_TX_MUX, -1, -1, -1 },
