From 79bf2f0228fd5f96d8e24b970d9f276fc948ddb0 Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Fri, 23 Oct 2026 08:43:25 +0000
Subject: [PATCH 23/54] MIPS: ingenic: make the HiBy R1's USB-C port a sink

The R1's TCS1421 USB Type-C port controller takes its role from two
pins, CFG0 on PA9 and CFG1 on PB24. The stock firmware drives both high,
dual-role: the port then attaches as a source about half the time, the
host sees no sink and supplies no VBUS, and the replug fails. The USB
controller is peripheral only, so hold both pins low: sink.
---
 arch/mips/boot/dts/ingenic/hiby-r1.dts | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/hiby-r1.dts b/arch/mips/boot/dts/ingenic/hiby-r1.dts
index 064b490..765007d 100644
--- a/arch/mips/boot/dts/ingenic/hiby-r1.dts
+++ b/arch/mips/boot/dts/ingenic/hiby-r1.dts
@@ -174,6 +174,30 @@ simple-audio-card,codec {
 	};
 };
 
+/*
+ * The USB-C port's TCS1421 takes its role from two pins, CFG0 (PA9) and
+ * CFG1 (PB24): both low is sink, both high (as the stock firmware leaves
+ * them) dual-role, which can attach as a source and leaves the host
+ * without VBUS. The USB controller is peripheral only: sink.
+ */
+&gpa {
+	usb-c-cfg0-hog {
+		gpio-hog;
+		gpios = <9 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "usb-c-cfg0";
+	};
+};
+
+&gpb {
+	usb-c-cfg1-hog {
+		gpio-hog;
+		gpios = <24 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "usb-c-cfg1";
+	};
+};
+
 &i2c0 {
 	status = "okay";
 
