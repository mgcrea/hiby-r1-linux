From a862323403b42af091eb67a18298ef7848b26818 Mon Sep 17 00:00:00 2001
From: Olivier Louvignes <olivier@mgcrea.io>
Date: Fri, 23 Oct 2026 05:57:55 +0000
Subject: [PATCH 04/55] MIPS: ingenic: add the X1600's MSC and OTG controllers

Describe both MSC controllers and the USB OTG controller, clocked by
fixed stand-ins at the rates the stock firmware leaves until there is an
X1600 CGU driver. On the HiBy R1, enable MSC1, which drives the SD card
slot (MSC0 is probably the Wi-Fi chip's SDIO link), and the OTG
controller as a peripheral.
---
 arch/mips/boot/dts/ingenic/hiby-r1.dts | 21 ++++++++
 arch/mips/boot/dts/ingenic/x1600.dtsi  | 67 ++++++++++++++++++++++++++
 2 files changed, 88 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/hiby-r1.dts b/arch/mips/boot/dts/ingenic/hiby-r1.dts
index 954cdcb..de7b8a3 100644
--- a/arch/mips/boot/dts/ingenic/hiby-r1.dts
+++ b/arch/mips/boot/dts/ingenic/hiby-r1.dts
@@ -46,3 +46,24 @@ framebuffer@2600000 {
 		format = "r5g6b5";
 	};
 };
+
+/* The SD card slot. MSC0 is probably the Wi-Fi chip's SDIO link. */
+&mmc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	cap-sd-highspeed;
+	/* The card-detect GPIO isn't known yet: poll. */
+	broken-cd;
+};
+
+&otg {
+	status = "okay";
+
+	/*
+	 * Peripheral only: host mode would need the USB-C controller as a
+	 * source and VBUS switched on through PC24.
+	 */
+	dr_mode = "peripheral";
+};
diff --git a/arch/mips/boot/dts/ingenic/x1600.dtsi b/arch/mips/boot/dts/ingenic/x1600.dtsi
index ebd9273..5a72270 100644
--- a/arch/mips/boot/dts/ingenic/x1600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x1600.dtsi
@@ -47,6 +47,29 @@ exclk: ext {
 		clock-frequency = <24000000>;
 	};
 
+	/*
+	 * Stand-ins for CGU outputs, at the rates the stock firmware leaves
+	 * them (read from its clk_summary): the gates are already open, and
+	 * nothing here may change a rate.
+	 */
+	otg_clk: otg-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <280000000>;
+	};
+
+	msc0_clk: msc0-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	msc1_clk: msc1-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
 	ost: timer@12000000 {
 		compatible = "ingenic,x1600-ost", "ingenic,x1000-ost";
 		reg = <0x12000000 0x3c>;
@@ -61,4 +84,48 @@ ost: timer@12000000 {
 		interrupt-parent = <&cpuintc>;
 		interrupts = <4>;
 	};
+
+	mmc0: mmc@13450000 {
+		compatible = "ingenic,x1600-mmc", "ingenic,x1000-mmc";
+		reg = <0x13450000 0x10000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <37>;
+
+		clocks = <&msc0_clk>;
+		clock-names = "mmc";
+
+		status = "disabled";
+	};
+
+	mmc1: mmc@13460000 {
+		compatible = "ingenic,x1600-mmc", "ingenic,x1000-mmc";
+		reg = <0x13460000 0x10000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <36>;
+
+		clocks = <&msc1_clk>;
+		clock-names = "mmc";
+
+		status = "disabled";
+	};
+
+	otg: usb@13500000 {
+		compatible = "ingenic,x1600-otg", "snps,dwc2";
+		reg = <0x13500000 0x40000>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <1>;
+
+		clocks = <&otg_clk>;
+		clock-names = "otg";
+
+		/* FIFO sizes from the vendor device tree. */
+		g-rx-fifo-size = <1096>;
+		g-np-tx-fifo-size = <512>;
+		g-tx-fifo-size = <16 16 16 128 256 256 512 768>;
+
+		status = "disabled";
+	};
 };
