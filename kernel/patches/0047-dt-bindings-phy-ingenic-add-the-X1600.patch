index 30b4200..b002dea 100644
--- a/Documentation/devicetree/bindings/phy/ingenic,phy-usb.yaml
+++ b/Documentation/devicetree/bindings/phy/ingenic,phy-usb.yaml
@@ -20,6 +20,7 @@ properties:
       - ingenic,jz4775-phy
       - ingenic,jz4780-phy
