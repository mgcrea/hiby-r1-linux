#!/bin/sh
# Wi-Fi under mainline: the AP6212's BCM43430A1 on MSC0, through brcmfmac
# (built into the card kernel; the flash kernel's modules are on the card,
# under its release, from flash-install.sh) and the stock wpa_supplicant
# (from the system image), with busybox's udhcpc.
#   r1-wifi on     power the chip up, start wpa_supplicant, then udhcpc
#   r1-wifi off    stop both and power the chip down
# The networks are /.r1-mainline/wifi.conf on the card (wpa_supplicant's
# format), copied to RAM: the card may go to a computer meanwhile.
ML=/mnt/sd_0/.r1-mainline
CONF=/tmp/wpa_supplicant.conf
CTRL=/tmp/wpa
# MSC0, whose removal powers the chip down (its mmc-pwrseq holds WL_REG_ON
# low) and takes brcmfmac off it: off leaves it unbound, so the next on
# starts the chip afresh. A chip still running its firmware from before
# connected to nothing.
MSC=/sys/bus/platform/drivers/jz4740-mmc

case "$1" in
on)
	# Before MSC0 is bound, so that brcmfmac finds the chip when it comes,
	# and finds brcmfmac-cyw (its vendor module) loaded when it attaches.
	if [ ! -d /sys/module/brcmfmac ]; then
		mods=$ML/modules/$(uname -r)
		for m in cfg80211 brcmutil brcmfmac brcmfmac-cyw; do
			[ -d /sys/module/$(echo $m | tr - _) ] && continue
			insmod $mods/$m.ko || { echo "can't load $mods/$m.ko"; exit 1; }
		done
	fi
	if [ ! -e $MSC/13450000.mmc ]; then
		echo 13450000.mmc > $MSC/bind
		i=0
		while [ ! -e /sys/bus/sdio/devices/mmc1:0001:1 ] && [ $i -lt 50 ]; do usleep 100000; i=$((i + 1)); done
	fi
	i=0
	while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 100 ]; do usleep 100000; i=$((i + 1)); done
	[ -e /sys/class/net/wlan0 ] || { echo "no wlan0"; exit 1; }
	command -v wpa_supplicant > /dev/null || { echo "no wpa_supplicant"; exit 1; }
	if [ -f $ML/wifi.conf ]; then
		cp $ML/wifi.conf $CONF
	else
		printf "ctrl_interface=%s\nupdate_config=1\n" $CTRL > $CONF
	fi
	# r1player and wpa_cli talk to it through $CTRL, whatever the card's
	# copy says.
	grep -q '^ctrl_interface=' $CONF || sed -i "1i ctrl_interface=$CTRL" $CONF
	ip link set wlan0 up
	wpa_supplicant -B -Dnl80211 -iwlan0 -c$CONF -P/tmp/wpa_supplicant.pid || exit 1
	# One quick try, then keeps asking in the background every 3 s until a
	# network answers (the first try usually goes before the association).
	udhcpc -b -t 1 -T 1 -A 3 -i wlan0 -s /sbin/r1-dhcp -p /tmp/udhcpc.pid -x hostname:hiby-r1 > /dev/null
	echo "Wi-Fi on"
	;;
off)
	for p in udhcpc wpa_supplicant; do
		[ -f /tmp/$p.pid ] && kill $(cat /tmp/$p.pid) 2>/dev/null
		rm -f /tmp/$p.pid
	done
	# Each step given 5 s: on a broken SDIO bus the driver blocks for good.
	timeout 5 ip link set wlan0 down 2>/dev/null
	rm -f /tmp/wifi-address
	[ -e $MSC/13450000.mmc ] && timeout 5 sh -c "echo 13450000.mmc > $MSC/unbind"
	echo "Wi-Fi off"
	;;
*)
	echo "usage: r1-wifi on|off"
	exit 2
	;;
esac
