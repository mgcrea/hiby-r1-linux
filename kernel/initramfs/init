#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sys /sys
# The kernel only auto-mounts devtmpfs on a real root, not an initramfs.
mount -t devtmpfs dev /dev
# Pseudo-terminals: r1player runs bluetoothctl on one, which buffers its
# output on a pipe.
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
# The watchdog: nothing before us armed it (the SPL doesn't), so a frozen
# kernel or a stuck boot would wait for a power-button restart. Opening it
# starts it; the daemon feeds it every 2 s and it resets the R1 10 s after
# the last time, after a panic too (the screen then keeps its last frame).
watchdog -T 10 -t 2 /dev/watchdog
# What the last boot logged before a reset, or its oops (ramoops).
mount -t pstore pstore /sys/fs/pstore
echo
echo "HiBy R1: Linux $(uname -r) is up"
grep -E "system type|cpu model|BogoMIPS" /proc/cpuinfo
free

# A shell on the USB serial gadget (/dev/cu.usbmodem* on the Mac), once
# r1-usb has created it below.
( while :; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &

# The SD card, read-only until writes are trusted. Given 30 s: once, after a
# kexec that followed big writes to it, it took 13 s to answer.
i=0
while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
if mount -t exfat -o ro /dev/mmcblk0p1 /mnt/sd_0; then
	echo "SD card:"; ls /mnt/sd_0
else
	echo "SD card: not mounted"; ls /dev | grep mmc
fi
# The kernel in flash hands over to the card's kernel here, if there is one
# (r1-loader); it returns when this kernel carries on.
/sbin/r1-loader
# The libraries, adbd, BlueZ and the font come from the system image in
# flash (`rootfs`, an LZO squashfs: tools/mksystem.py, or stock's root
# filesystem, which has them at the same paths) so that nothing runs from
# the card, which can then go to a computer as a USB disk (r1-share). If
# that doesn't mount, or `no-rom` on the card says not to (while
# tools/system-install.sh rewrites the slot), from the card, where
# tools/sdsync.sh copied them.
ML=/mnt/sd_0/.r1-mainline
mtd=$(grep '"rootfs"$' /proc/mtd | cut -d: -f1)
mkdir -p /rom /tmp/firmware/brcm
if [ -n "$mtd" ] && [ ! -e $ML/no-rom ] && mount -t squashfs -o ro /dev/mtdblock${mtd#mtd} /rom; then
	echo "system: /rom ($mtd)"
	ln -s /rom/lib /lib
	ln -s /rom/usr/lib /usr/lib
	ln -s /rom/usr/resource/fonts/default.otf /usr/resource/fonts/default.otf
	export PATH=$PATH:/rom/usr/bin:/rom/usr/sbin:/rom/usr/libexec/bluetooth
else
	echo "system: the card"
	ln -s $ML/lib /lib
	ln -s $ML/default.otf /usr/resource/fonts/default.otf
	export PATH=$PATH:$ML:$ML/bt
fi
# The Bluetooth firmware for this module (the card's copy, which sdsync.sh
# picked, else the system image's), in RAM: the chip may load it again while
# the card is away. r1-bt binds hci_bcm again so that it does, from here.
cp $ML/lib/firmware/brcm/BCM43430A1.hcd /tmp/firmware/brcm/ 2>/dev/null ||
	cp /rom/lib/firmware/brcm/BCM43430A1.hcd /tmp/firmware/brcm/ 2>/dev/null
echo -n /tmp/firmware > /sys/module/firmware_class/parameters/path
# Modules come from beside the card's kernel (r1-modprobe), for Wi-Fi
# (r1-wifi, which r1player runs). Wi-Fi's firmware is in /lib/firmware,
# the kernel's own fallback path, from the system image.
echo /sbin/r1-modprobe > /proc/sys/kernel/modprobe
# What has to outlive a restart lives on the card, in $R1_STATE: r1player
# copies its settings and scores there, and bluetoothd's pairings, in a
# short read-write window. Put them back where r1player and bluetoothd
# look, which are in RAM, before either starts. (HiBy built bluetoothd
# with its storage in /usr/data/bluetooth, not /var/lib/bluetooth.)
export R1_STATE=/mnt/sd_0/.r1-mainline/state
mkdir -p /usr/data/r1player /usr/data/bluetooth
for f in settings scores; do
	[ -f $R1_STATE/$f ] && cp $R1_STATE/$f /usr/data/r1player/
done
# The pairings come as a tar of /usr/data/bluetooth: exFAT refuses BlueZ's
# directory names, which are addresses with colons.
[ -f $R1_STATE/bluetooth.tar ] && tar -xf $R1_STATE/bluetooth.tar -C /usr/data
# The USB gadget: serial shell, ADB when there is an adbd, and the card
# reader r1-share hands the card to.
/sbin/r1-usb > /tmp/usb.log 2>&1
# Bluetooth, in the background, since setting the chip up takes a few
# seconds. Its tools (bluetoothctl, bluealsa-cli) are on r1player's PATH.
/sbin/r1-bt > /tmp/bt.log 2>&1 &

# r1player, when tools/sdsync.sh put it on the card. The console gives the
# screen up first: fbcon would draw kernel messages over the player.
# /usr/data/r1player (its index) is in RAM, so the index is rebuilt at
# every boot.
# This kernel came up: clear the kexec flag (r1-loader).
/sbin/r1-loader done

# A log of this start on the card, 30 s in, for the last five starts
# (/.r1-mainline/logs/boot.0 is this one): what the kernel said about USB
# and the SD cards, and the USB state, so that a start that never reached
# the computer can be read afterwards. Skipped while the card is shared.
( sleep 30
	log=/tmp/boot.log
	{ echo "== $(uname -r), up $(cut -d' ' -f1 /proc/uptime) s"
	dmesg | grep -i -E 'r1-loader|dwc2|usb|udc|mmc|exfat|brcm|error|fail|timeout'
	echo "== udc: $(cat /sys/class/udc/*/state 2>&1), usb power: $(cat /sys/class/power_supply/axp20x-usb/online 2>&1)"
	echo "== usb.log"; cat /tmp/usb.log; echo "== adb.log"; tail -n 5 /tmp/adb.log
	free; } > $log 2>&1
	grep -q ' /mnt/sd_0 ' /proc/mounts && [ ! -e /tmp/sd-shared ] &&
		mount -o remount,rw /mnt/sd_0 && {
		mkdir -p $ML/logs
		for n in 3 2 1 0; do [ -f $ML/logs/boot.$n ] && mv $ML/logs/boot.$n $ML/logs/boot.$((n + 1)); done
		cp $log $ML/logs/boot.0
		sync; mount -o remount,ro /mnt/sd_0; } ) &

# It runs from a copy in RAM, which each restart takes again from the card
# (killing it picks up a new build), unless the card is with the computer.
player=$ML/r1player
if [ -x $player ]; then
	for vt in /sys/class/vtconsole/vtcon*; do
		grep -q "frame buffer" $vt/name && echo 0 > $vt/bind
	done
	( while :; do
		cp $player /tmp/r1player.new 2>/dev/null && mv /tmp/r1player.new /tmp/r1player
		/tmp/r1player >> /tmp/r1player.log 2>&1
		echo "r1player exited with $?" >> /tmp/r1player.log
		sleep 2
	done ) &
	wait
fi

# A clock that ticks on screen shows the timer and interrupts work. It
# rewrites one line so the boot log above stays readable.
while :; do
	printf "\ruptime %s s " "$(cut -d' ' -f1 /proc/uptime)"
	sleep 1
done
